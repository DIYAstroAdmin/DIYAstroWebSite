# DIY Astro — Apache configuration for IONOS web hosting

# Custom 404 page
ErrorDocument 404 /404.html

# Serve index.html for directory URLs (e.g. /projects/)
DirectoryIndex index.html

# Correct MIME type for SVG images
AddType image/svg+xml .svg

# ---------------------------------------------------------------------------
# Force HTTPS and the www. host name.
# Uncomment ONLY after the SSL certificate is active for diyastro.co.uk
# (IONOS control panel > Domains & SSL), otherwise visitors will see errors.
# ---------------------------------------------------------------------------
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://www.diyastro.co.uk%{REQUEST_URI} [L,R=301]
# RewriteCond %{HTTP_HOST} ^diyastro\.co\.uk$ [NC]
# RewriteRule ^ https://www.diyastro.co.uk%{REQUEST_URI} [L,R=301]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/xml application/xml text/plain
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Don't list directory contents
Options -Indexes
